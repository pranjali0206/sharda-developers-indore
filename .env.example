# Copy to .env.local and fill in. All are optional except where noted.

# Public URL of the live site (no trailing slash). Required for canonical tags,
# Open Graph URLs and sitemap.xml. TODO: client to confirm the domain.
VITE_SITE_URL=

# Where the site-visit form POSTs JSON (Google Apps Script web app / CRM webhook).
# See docs/lead-endpoint.gs. Without it, production submissions show the "call us" error.
VITE_LEAD_ENDPOINT=

# Google Analytics 4 measurement ID (G-XXXXXXX). Analytics loads only if set.
VITE_GA4_ID=

# Meta Pixel ID. Pixel loads only if set.
VITE_META_PIXEL_ID=

# Digits only, with country code. TODO: client to confirm this number is on WhatsApp.
VITE_WHATSAPP_NUMBER=919179200110

# Digits only, with country code.
VITE_PHONE=919179200110
