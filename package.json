{
  "name": "sharda-developers-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketing website for Sharda Developers, Indore — Sharda Paradise & Sharda Greens.",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/optimize-images.mjs",
    "build": "npm run images && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "typecheck": "tsc -b",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "node scripts/verify.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.1.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
